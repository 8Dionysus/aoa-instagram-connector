# aoa-instagram-connector keeps secrets out of repository-managed environment files.
AOA_INSTAGRAM_CONNECTOR_STATE_ROOT=
AOA_INSTAGRAM_CONNECTOR_PROFILE=starter
AOA_INSTAGRAM_CREDENTIALS_FILE=
AOA_INSTAGRAM_API_VERSION=v26.0
AOA_INSTAGRAM_ACCESS_TOKEN=
# Leave the token empty in Git. Fill only the owner-local mode-0600 credential file.
