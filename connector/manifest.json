{
  "schema": "aoa_social_connector_manifest_v1",
  "connector_id": "aoa-instagram-connector",
  "provider": "instagram",
  "display_name": "Instagram",
  "version": "0.2.0-dev",
  "phase": "experimental",
  "source_family": "social-network",
  "runtime_owner": "abyss-stack",
  "policy_snapshot_date": "2026-09-04",
  "official_docs": "https://developers.facebook.com/docs/instagram-platform/",
  "planes": {
    "evidence": {
      "status": "implemented_unadmitted",
      "effect": "read_only"
    },
    "draft": {
      "status": "planned",
      "effect": "none"
    },
    "publication_plan": {
      "status": "planned",
      "effect": "none"
    },
    "publication_commit": {
      "status": "disabled",
      "effect": "external_write",
      "requires_approval": true
    }
  },
  "capabilities": {
    "read": [
      "professional_account_profile",
      "professional_account_media",
      "comments",
      "mentions",
      "media_insights"
    ],
    "implemented_read": [
      "professional_account_profile",
      "professional_account_media"
    ],
    "publish": [
      "image",
      "video",
      "reel",
      "carousel",
      "story"
    ],
    "deferred": [
      "consumer_account_access",
      "arbitrary_public_search",
      "hashtag_media",
      "ads_and_tagging"
    ]
  },
  "auth": {
    "mode": "instagram_login",
    "required_scope": "instagram_business_basic",
    "default_api_version": "v26.0",
    "credentials": "operator-local",
    "access_level": "standard_for_owned_or_test_accounts"
  },
  "policy": {
    "official_api_only": true,
    "scraping_enabled": false,
    "credentials_in_repo": false,
    "publication_default": "disabled"
  }
}
